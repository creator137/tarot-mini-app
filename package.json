{
  "name": "tarot-mini-app",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "overrides": { "esbuild": "^0.28.2" },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "test:postgres": "tsx --env-file=.env tests/postgres.integration.ts",
    "test:e2e": "tsx --env-file=.env tests/api.e2e.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "cards:validate": "node scripts/cards-validate.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "nuxt": "^4.6.2",
    "pg": "^8.16.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "node": "^24.22.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
